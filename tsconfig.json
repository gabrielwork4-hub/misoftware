{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
