---
import type { CollectionEntry } from 'astro:content';
import ArticleCard from './ArticleCard.astro';

interface Props {
  articles: CollectionEntry<'fila'>[];
}

const { articles } = Astro.props;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16" id="artigos">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
    <div>
      <div class="flex items-center gap-1.5 text-xs font-mono text-brand-700 font-bold uppercase tracking-wider mb-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
        Publicações Recentes
      </div>
      <h2 class="text-3xl sm:text-4xl font-serif text-slate-950 font-normal tracking-tight">
        Últimos Artigos &amp; <span class="italic-serif">Análises</span>
      </h2>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
    {articles.map((entry) => <ArticleCard entry={entry} />)}
  </div>

  <div class="mt-12 text-center">
    <a
      href="/artigos/"
      class="px-6 py-2.5 text-xs font-semibold font-mono tracking-wide rounded-full border border-slate-300 text-slate-700 bg-white hover:bg-slate-50 hover:border-slate-400 transition-all inline-flex items-center gap-2"
    >
      <span>Ver todos os artigos</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
    </a>
  </div>
</section>
