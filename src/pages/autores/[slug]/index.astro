---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getPublishedArticles } from '@/lib/articles';
import { SITE } from '@/consts';

export async function getStaticPaths() {
  const autores = await getCollection('autores', ({ data }) => !data.draft);
  return autores.map((autor) => ({
    params: { slug: autor.id },
    props: { autor },
  }));
}

const { autor } = Astro.props;
const { data } = autor;
const { Content } = await render(autor);

// Artigos assinados por este autor, mais recentes primeiro.
const articles = (await getPublishedArticles()).filter((a) => a.data.author.id === autor.id);

const initials = data.name
  .split(' ')
  .map((w) => w[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const profileUrl = new URL(`/autores/${autor.id}/`, Astro.site ?? SITE.url).toString();

// Schema Person/Organization do perfil (sameAs consolida a entidade do autor).
const personSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': data.entity,
  name: data.name,
  url: profileUrl,
  jobTitle: data.role,
};
if (data.bio) personSchema.description = data.bio;
if (data.org) personSchema.worksFor = { '@type': 'Organization', name: data.org };
if (data.sameAs.length > 0) personSchema.sameAs = data.sameAs;
---

<BaseLayout title={data.name} description={data.bio ?? `${data.name} — ${data.role} na ${SITE.name}.`}>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-xs font-mono text-slate-400 mb-6" aria-label="Trilha de navegação">
      <a href="/" class="hover:text-brand-600">Início</a>
      <span class="mx-1.5">/</span>
      <a href="/autores/" class="hover:text-brand-600">Autores</a>
      <span class="mx-1.5">/</span>
      <span class="text-slate-600">{data.name}</span>
    </nav>

    <header class="flex flex-col sm:flex-row items-start gap-6 mb-10">
      <div class="w-24 h-24 rounded-full overflow-hidden border border-slate-200 bg-slate-900 shrink-0 shadow-xs">
        <img
          src={`/images/autores/${autor.id}.webp`}
          alt={data.name}
          width="96"
          height="96"
          loading="eager"
          class="w-full h-full object-cover"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div class="hidden w-full h-full bg-brand-50 text-brand-700 font-mono font-bold text-2xl items-center justify-center border border-brand-100">{initials}</div>
      </div>
      <div>
        <div class="text-xs font-mono text-brand-700 font-bold uppercase tracking-wider mb-1">{data.role}</div>
        <h1 class="text-4xl sm:text-5xl font-serif text-slate-950 tracking-tight leading-tight">{data.name}</h1>
        {data.org && <p class="text-sm text-slate-500 font-mono mt-2">{data.org}</p>}
        {
          data.sameAs.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-4">
              {data.sameAs.map((link) => (
                <a href={link} rel="me noopener" target="_blank" class="text-xs font-mono px-3 py-1 rounded-full border border-slate-200 text-slate-600 hover:text-brand-600 hover:border-brand-300 transition-colors">
                  {new URL(link).hostname.replace(/^www\./, '')}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div
      class="prose-editorial font-serif text-slate-800 text-lg leading-relaxed
             [&_p]:mb-5 [&_a]:text-brand-600 [&_a]:underline [&_a]:underline-offset-4
             [&_strong]:text-slate-900 [&_strong]:font-semibold [&_blockquote]:text-slate-500 [&_blockquote]:border-l-2 [&_blockquote]:border-slate-200 [&_blockquote]:pl-4 [&_blockquote]:italic"
    >
      <Content />
    </div>

    <section class="mt-14">
      <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 mb-6">
        Artigos de {data.name}
      </h2>
      {
        articles.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-7">
            {articles.map((a) => <ArticleCard entry={a} />)}
          </div>
        ) : (
          <p class="text-slate-500 font-serif">Ainda não há artigos publicados por este autor.</p>
        )
      }
    </section>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
</BaseLayout>
