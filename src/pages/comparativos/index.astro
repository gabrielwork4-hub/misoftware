---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';

const entries = (await getCollection('fila', ({ data }) => !data.draft && data.kind === 'comparativo')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Comparativos"
  description="Comparativos da misoftware entre ferramentas de IA, automação e desenvolvimento, com critérios técnicos e fontes."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10">
      <div class="text-xs font-mono text-brand-700 font-bold uppercase tracking-wider mb-1">Editorial</div>
      <h1 class="text-3xl sm:text-4xl font-serif text-slate-950 tracking-tight">Comparativos</h1>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {entries.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
