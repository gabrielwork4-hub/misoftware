---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

// Corpo editorial do diretório (pilar `/ferramentas/`), quando publicado.
const pilar = await getEntry('pilares', 'ferramentas');
const PilarContent = pilar ? (await render(pilar)).Content : null;

const hubs = (await getCollection('hubs', ({ data }) => !data.draft && data.silo === 'ferramentas')).sort(
  (a, b) => a.data.cluster.localeCompare(b.data.cluster)
);

const tools = (await getCollection('ferramentas', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0)
);

const title = pilar?.data.title ?? 'Ferramentas';
const description =
  pilar?.data.description ??
  'Diretório curado de ferramentas de IA, desenvolvimento, automação e produtividade testadas pela misoftware.';
---

<BaseLayout title={title} description={description}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10 max-w-3xl">
      <div class="text-xs font-mono text-brand-700 font-bold uppercase tracking-wider mb-1">Diretório</div>
      <h1 class="text-3xl sm:text-4xl font-serif text-slate-950 tracking-tight">{title}</h1>
      <p class="text-lg text-slate-600 font-serif leading-relaxed mt-3">{description}</p>
    </header>

    {
      PilarContent && (
        <div class="prose-editorial max-w-3xl font-serif text-slate-800 text-lg leading-relaxed [&_h2]:font-sans [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-slate-900 [&_h2]:mt-10 [&_h2]:mb-4 [&_a]:text-brand-600 [&_a]:underline [&_a]:underline-offset-4 mb-16">
          <PilarContent />
        </div>
      )
    }

    {
      hubs.length > 0 && (
        <div class="mb-16">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 mb-6">Categorias de ferramentas</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
            {hubs.map((hub) => (
              <a
                href={`/${hub.data.silo}/${hub.data.clusterSlug}/`}
                class="relative p-6 rounded-xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-lg hover:border-brand-300 transition-all flex flex-col group"
              >
                <span class="text-[10px] font-mono font-semibold text-brand-700 uppercase tracking-wider">Hub</span>
                <h3 class="text-lg font-serif font-semibold text-slate-900 group-hover:text-brand-600 transition-colors leading-snug mt-2">{hub.data.title}</h3>
                <p class="text-xs text-slate-600 mt-2 line-clamp-3 leading-relaxed flex-1">{hub.data.description}</p>
                <span class="text-brand-600 group-hover:translate-x-1 transition-transform mt-4">→</span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 mb-6">Ferramentas testadas</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        tools.map((tool) => (
          <a
            href={`/ferramentas/${tool.id}/`}
            class="relative p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-md hover:border-brand-300 transition-all flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center border border-brand-100 font-mono font-bold">
                  {tool.data.name.slice(0, 1)}
                </div>
                {tool.data.rating && (
                  <span class="text-[11px] font-mono font-bold px-2 py-0.5 rounded bg-brand-50 text-brand-700 border border-brand-100/60">
                    Nota {tool.data.rating}
                  </span>
                )}
              </div>
              <h2 class="font-serif font-bold text-lg text-slate-900 group-hover:text-brand-600 transition-colors">{tool.data.name}</h2>
              <p class="text-xs text-slate-600 mt-2 leading-relaxed line-clamp-3">{tool.data.description}</p>
            </div>
            <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono text-slate-400">
              <span>{tool.data.pricing} • {tool.data.category}</span>
              <span class="group-hover:text-brand-600">→</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
