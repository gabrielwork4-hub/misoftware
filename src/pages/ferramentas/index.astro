---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Faq from '@/components/Faq.astro';

const tools = (await getCollection('ferramentas', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0)
);

// Corpo do pilar /ferramentas/ (kind: pilar na coleção `fila`) — antes não
// renderizado. Alimenta a prosa, a FAQ (FAQPage) e as fontes.
const pillar = (
  await getCollection('fila', ({ data }) => data.kind === 'pilar' && data.canonicalPath === '/ferramentas/')
)[0];
const PillarBody = pillar ? (await render(pillar)).Content : null;
const faq = pillar?.data.faq ?? [];
const sourceUrls = pillar?.data.sources ?? [];
---

<BaseLayout
  title="Ferramentas"
  description="Diretório curado de ferramentas de IA, desenvolvimento, automação e produtividade testadas pela misoftware."
  type="article"
  faq={faq}
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10 max-w-3xl">
      <div class="text-xs font-mono text-brand-700 font-bold uppercase tracking-wider mb-1">Diretório</div>
      <h1 class="text-3xl sm:text-4xl font-serif text-slate-950 tracking-tight">Ferramentas <span class="italic-serif text-brand-600">testadas</span></h1>
      <p class="text-lg text-slate-600 font-serif leading-relaxed mt-3">
        Curadoria criteriosa de plataformas de IA, desenvolvimento e produtividade validadas pela nossa bancada.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        tools.map((tool) => (
          <a
            href={`/ferramentas/${tool.id}/`}
            class="relative p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-md hover:border-brand-300 transition-all flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-11 h-11 rounded-xl overflow-hidden bg-slate-900 border border-slate-800 flex items-center justify-center shadow-xs">
                  <img
                    src={`/images/ferramentas/${tool.id}.webp`}
                    alt={tool.data.name}
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="hidden w-full h-full items-center justify-center font-mono font-bold text-brand-400 bg-brand-950">
                    {tool.data.name.slice(0, 1)}
                  </div>
                </div>
                {tool.data.rating && (
                  <span class="text-[11px] font-mono font-bold px-2 py-0.5 rounded bg-brand-50 text-brand-700 border border-brand-100/60">
                    Nota {tool.data.rating}
                  </span>
                )}
              </div>
              <h2 class="font-serif font-bold text-lg text-slate-900 group-hover:text-brand-600 transition-colors">{tool.data.name}</h2>
              <p class="text-xs text-slate-600 mt-2 leading-relaxed line-clamp-3">{tool.data.description}</p>
            </div>
            <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono text-slate-400">
              <span>{tool.data.pricing} • {tool.data.category}</span>
              <span class="group-hover:text-brand-600">→</span>
            </div>
          </a>
        ))
      }
    </div>

    {PillarBody && (
      <div class="prose-editorial mx-auto mt-14 pt-10 border-t border-slate-200 font-serif text-slate-800 text-lg leading-relaxed [&_h2]:font-sans [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-slate-900 [&_h2]:mt-10 [&_h2]:mb-4 [&_a]:text-brand-600 [&_a]:underline [&_a]:underline-offset-4">
        <PillarBody />
      </div>
    )}

    <Faq items={faq} />

    {sourceUrls.length > 0 && (
      <aside class="max-w-3xl mx-auto mt-12 pt-6 border-t border-slate-200">
        <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 mb-3">Fontes</h2>
        <ul class="space-y-1.5 text-sm">
          {sourceUrls.map((url) => <li><a href={url} class="text-brand-600 underline underline-offset-4" rel="nofollow noopener" target="_blank">{url}</a></li>)}
        </ul>
      </aside>
    )}
  </section>
</BaseLayout>
