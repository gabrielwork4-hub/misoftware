---
import { getCollection } from 'astro:content';
import EditorialQueuePage from '@/components/EditorialQueuePage.astro';

export async function getStaticPaths() {
  const queued = await getCollection('fila', ({ data }) => data.kind === 'artigo');
  return queued.map((entry) => ({
    params: { id: entry.data.canonicalPath.replace(/^\/artigos\//, '').replace(/\/$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<EditorialQueuePage entry={entry} />
