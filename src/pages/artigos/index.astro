---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';

const articles = (await getCollection('artigos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Artigos"
  description="Todos os artigos e análises da misoftware: IA, automação, desenvolvimento e ferramentas."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10">
      <div class="text-xs font-mono text-brand-700 font-bold uppercase tracking-wider mb-1">Editorial</div>
      <h1 class="text-3xl sm:text-4xl font-serif text-slate-950 tracking-tight">Todos os Artigos &amp; <span class="italic-serif">Análises</span></h1>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {articles.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
