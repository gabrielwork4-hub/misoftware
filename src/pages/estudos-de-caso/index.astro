---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const casos = (await getCollection('estudos-de-caso', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const cards = await Promise.all(
  casos.map(async (entry) => {
    const author = await getEntry(entry.data.author);
    return { entry, authorName: author?.data.name ?? 'Redação misoftware' };
  })
);
---

<BaseLayout
  title="Estudos de caso"
  description="Aplicações reais de IA e automação — o que foi feito, o que funcionou e o que não funcionou."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10 max-w-3xl">
      <div class="text-xs font-mono text-brand-700 font-bold uppercase tracking-wider mb-1">Prova</div>
      <h1 class="text-3xl sm:text-4xl font-serif text-slate-950 tracking-tight">Estudos de <span class="italic-serif text-brand-600">caso</span></h1>
      <p class="text-lg text-slate-600 font-serif leading-relaxed mt-3">
        Resultados reais, com contexto, limites e o que aprendemos no caminho.
      </p>
    </header>

    {
      cards.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
          {cards.map(({ entry, authorName }) => (
            <a
              href={`/estudos-de-caso/${entry.id}/`}
              class="relative p-6 rounded-xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-lg hover:border-brand-300 transition-all flex flex-col group"
            >
              <span class="text-[10px] font-mono font-semibold text-brand-700 uppercase tracking-wider">Estudo de caso · {entry.data.category}</span>
              <h2 class="text-lg font-serif font-semibold text-slate-900 group-hover:text-brand-600 transition-colors leading-snug mt-2">{entry.data.title}</h2>
              <p class="text-xs text-slate-600 mt-2 line-clamp-3 leading-relaxed flex-1">{entry.data.description}</p>
              <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-[11px] font-mono text-slate-400">
                <span>{authorName}</span>
                <span class="group-hover:text-brand-600">→</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-slate-500 font-serif text-lg">Estudos de caso em produção. Volte em breve.</p>
      )
    }
  </section>
</BaseLayout>
