---
import { getCollection } from 'astro:content';
import EditorialQueuePage from '@/components/EditorialQueuePage.astro';
export async function getStaticPaths() {
  const entries = await getCollection('fila', ({ data }) => data.canonicalPath.startsWith('/automacao/') && data.canonicalPath !== '/automacao/');
  return entries.map((entry) => ({ params: { id: entry.data.canonicalPath.replace(/^\/automacao\//, '').replace(/\/$/, '') }, props: { entry } }));
}
const { entry } = Astro.props;
---
<EditorialQueuePage entry={entry} />
