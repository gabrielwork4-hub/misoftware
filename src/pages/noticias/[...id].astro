---
import { getCollection } from 'astro:content';
import EditorialQueuePage from '@/components/EditorialQueuePage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('fila', ({ data }) => data.kind === 'noticia' && !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.data.canonicalPath.replace(/^\/noticias\//, '').replace(/\/$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<EditorialQueuePage entry={entry} />
