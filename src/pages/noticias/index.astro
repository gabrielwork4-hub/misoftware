---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getPublishedArticles } from '@/lib/articles';

const news = (await getPublishedArticles()).filter((entry) => entry.data.kind === 'noticia');
---

<BaseLayout
  title="Notícias"
  description="Notícias de tecnologia aplicada na misoftware: lançamentos e mudanças em IA, ferramentas de desenvolvimento e automação, com fontes primárias."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="mb-10">
      <div class="text-xs font-mono text-brand-700 font-bold uppercase tracking-wider mb-1">Editorial</div>
      <h1 class="text-3xl sm:text-4xl font-serif text-slate-950 tracking-tight">Notícias &amp; <span class="italic-serif">Atualizações</span></h1>
      <p class="mt-3 max-w-2xl text-slate-600 font-serif text-lg leading-relaxed">O que mudou em IA, ferramentas de desenvolvimento e automação — com data, fonte oficial e o que muda na prática.</p>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      {news.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
